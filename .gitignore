Bilder/
10. März 2026/
10. Juli 2026/

# Browser-automation scratch (screenshots of live dashboards + console logs).
# Same sensitivity as the section above — the shots show real telemetry.
.playwright-mcp/

# Per-session git worktrees. A worktree checkout inside the repo is picked up by
# `git add -A` as a gitlink (mode 160000) with no .gitmodules entry — that shipped
# once already and broke `git submodule status` for every clone.
.claude/worktrees/

# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc

# Seed data is regeneratable — keep out of git
dashboard/seed.json

# FitNesse local preview (generated by scripts/fitnesse_preview_build.py)
docs/fitnesse/preview/

# FitNesse markdown export (generated by scripts/fitnesse_to_markdown.py)
docs/fitnesse/markdown/

# Local config — copy .env.example to .env and fill in real values
.env
