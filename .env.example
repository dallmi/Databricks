# Copy this file to .env and fill in your values.
# .env is gitignored so secrets and per-machine paths stay out of git.
# Shell exports (e.g. $env:FITNESSE_URL=...) still win over .env values.

# ---------------------------------------------------------------------------
# FitNesse — required for upload/download/backup scripts
# ---------------------------------------------------------------------------
FITNESSE_URL=http://<host>:<port>
FITNESSE_PARENT_PATH=FrontPage.<Parent.Path>
# Optional second subtree for fitnesse_backup_crawl.py --target alt.
# Leave empty if you only back up one subtree.
FITNESSE_ALT_PARENT_PATH=
FITNESSE_ROOT_NAME=MultiChannelDataModel

# FitNesse — paths and tuning (optional; defaults shown).
# Relative paths are resolved against the repo root.
FITNESSE_PAGES_DIR=docs/fitnesse/pages
FITNESSE_BACKUP_ROOT=docs/fitnesse/backup
FITNESSE_MARKDOWN_DIR=docs/fitnesse/markdown
FITNESSE_REQUEST_DELAY=0.3

# ---------------------------------------------------------------------------
# AppInsights / flatten pipeline — placeholders, not yet wired into scripts.
# Uncomment and we can route flatten_appinsights.py through these next.
# ---------------------------------------------------------------------------
#APPINSIGHTS_INPUT_DIR=input
#APPINSIGHTS_OUTPUT_DIR=output
#APPINSIGHTS_HR_PATH=../SearchAnalytics/output/hr_history.parquet
#APPINSIGHTS_DB_PATH=output/pageviews.duckdb

# ---------------------------------------------------------------------------
# Databricks — placeholders for when SQL/DBX scripts land.
# ---------------------------------------------------------------------------
#DATABRICKS_WORKSPACE_URL=https://adb-xxx.azuredatabricks.net
#DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
#DATABRICKS_CATALOG=main
#DATABRICKS_SCHEMA_BRONZE=imep_bronze
#DATABRICKS_SCHEMA_GOLD=imep_gold
